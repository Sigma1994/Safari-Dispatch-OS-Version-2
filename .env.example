# Database Configuration (auto = use local Docker PostgreSQL if reachable, fallback to SQLite)
DB_CLIENT=auto
PGHOST=localhost
PGPORT=5432
PGDATABASE=safari_dispatch
PGUSER=safari
PGPASSWORD=safari_dev

# Local Ollama (Primary Default AI Engine for NLU Extraction & Grounded NLG Synthesis)
USE_DETERMINISTIC_LLM=0
OLLAMA_MODEL="qwen3:4b"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TIMEOUT_SEC=30

# Optional Production Cloud LLM (Disabled by default; enable only if deploying with an online LLM key)
ENABLE_ONLINE_LLM=0
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL & Dispatch Policy Guardrails
APP_URL="MY_APP_URL"
USD_TO_KES_RATE=129.5
MAX_AUTO_DISCOUNT_PCT=10.0
MAX_DAILY_DRIVE_HOURS_SAFE=7.5
